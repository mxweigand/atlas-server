OPENAI_API_KEY=sk-...

# GA realtime model
# OPENAI_MODEL=gpt-realtime-2

# Voice and reasoning tuning
# OPENAI_VOICE=marin
# OPENAI_REASONING_EFFORT=low        # minimal | low | medium | high | xhigh

# VAD
# VAD_TYPE=semantic_vad              # semantic_vad | server_vad
# VAD_EAGERNESS=high                 # low | medium | high | auto (semantic_vad only)
# VAD_SILENCE_MS=300                 # server_vad only
# VAD_THRESHOLD=0.5                  # server_vad only
# VAD_PREFIX_MS=300                  # server_vad only

# OpenAI WebSocket reconnect backoff
# RECONNECT_MAX_RETRIES=3
# RECONNECT_INITIAL_DELAY_MS=1000
# RECONNECT_BACKOFF_MULTIPLIER=2

# Input transcription logging (JSONL)
# INPUT_TRANSCRIPTION_LOGGING=true
# INPUT_TRANSCRIPTION_LOG_DIR=logs
# INPUT_TRANSCRIPTION_LANGUAGE=de

# Deixis pipeline
# DEIXIS_PIPELINE_LATENCY_MS=1000    # subtracted from delta timestamps to estimate spoken time
# DEIXIS_FOCUS_BUFFER_MS=30000       # rolling window for focus samples
# DEIXIS_DELTA_BUFFER_MS=30000       # rolling window for transcript deltas
# DEIXIS_AMBIGUITY_WINDOW_MS=200     # ± window around spoken time; a focus change inside it is ambiguous
# DEIXIS_STALE_THRESHOLD_MS=500      # max age of newest focus sample at/before spoken time before it counts as a gap

# Audio pipeline
# AUDIO_LOOKBACK_MS=1500             # mic buffer kept ahead of speech_started so VAD-cut prefix survives

# Server ports
# WS_PORT=8080
# PORT=3000
